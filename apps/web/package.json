{
    "name": "@xlibraries/web",
    "version": "2.0.0",
    "private": true,
    "homepage": "https://xlibraries.com/",
    "scripts": {
        "dev": "node scripts/vendor.mjs && next dev",
        "build": "node scripts/vendor.mjs && xlib-music-snapshot --playlists data/music-playlists.json --out public/music/snapshot.json; next build --webpack",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit",
        "test:e2e": "playwright test",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:python": "python3 -m unittest discover -s tests/python",
        "verify": "eslint . && next typegen && tsc --noEmit && vitest run && python3 -m unittest discover -s tests/python && node scripts/vendor.mjs && next build --webpack && playwright test",
        "prepare": "node scripts/vendor.mjs"
    },
    "engines": {
        "node": ">=20.9.0"
    },
    "dependencies": {
        "@emailjs/browser": "^3.10.0",
        "@india-boundary-corrector/leaflet-layer": "0.2.2",
        "@xlibraries/analytics": "workspace:^",
        "@xlibraries/app-sdk": "workspace:^",
        "@xlibraries/arcade": "workspace:^",
        "@xlibraries/bot-lab": "workspace:^",
        "@xlibraries/browser": "workspace:^",
        "@xlibraries/music": "workspace:^",
        "@xlibraries/photo-drop": "workspace:^",
        "@xlibraries/terminal": "workspace:^",
        "autoprefixer": "^10.4.13",
        "leaflet": "1.9.4",
        "next": "^16.4.2",
        "pdfjs-dist": "^4.8.69",
        "postcss": "^8.4.21",
        "react": "^19.2.9",
        "react-dom": "^19.2.9",
        "react-draggable": "^4.7.2",
        "tailwindcss": "^3.2.4"
    },
    "devDependencies": {
        "@playwright/test": "1.56.1",
        "@types/leaflet": "1.9.20",
        "@types/node": "^25.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "3.2.4",
        "eslint": "^9.0.0",
        "eslint-config-next": "16.4.2",
        "typescript": "^5.9.3",
        "vitest": "3.2.4"
    }
}
