# Copy to .env.local for local development. In production these are set in
# Vercel → Project → Settings → Environment Variables (all are public, NEXT_PUBLIC_ = sent to the browser).

# Canonical site URL used for SEO tags (defaults to https://xlibraries.com)
NEXT_PUBLIC_SITE_URL=https://xlibraries.com

# Admin mode at /xlib and the site's own analytics (docs/admin-plan.md). Server-only, never sent to the browser.
# KV_*: added by Vercel → Storage → Upstash for Redis. Without them, tracking quietly does nothing.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The passcode for the /xlib lock screen, and a random signing key (openssl rand -hex 32, at least 32 characters)
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=

# EmailJS, for the "Contact Me" app (https://www.emailjs.com/)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Not sent to the browser: only used by `pnpm deploy:photo-drop` (Apps Script editor → Project Settings → Script ID)
PHOTO_DROP_SCRIPT_ID=
