# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (pnpm is the package manager; see packageManager in package.json)
/node_modules
/.pnp
.pnp.js
package-lock.json
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/
/build

# local env files (copy .env.example to .env.local)
.env*
!.env.example

# editors and OS
.DS_Store
.vs/
.vscode/
*.pem

# installers and other large binaries don't belong in the repo
*.msi
*.exe
*.dmg

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# vercel
/.vercel/

# generated by Next.js (references .next/ types)
next-env.d.ts
