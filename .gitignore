# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (pnpm is the package manager; see packageManager in package.json)
node_modules
.pnp
.pnp.js
package-lock.json
yarn.lock

# testing
coverage

# downloaded build tools (pinned; see packages/tooling)
.tools/

# next.js
.next/
out/
build

# local env files (copy .env.example to .env.local)
.env*
!.env.example

# editors and OS
.DS_Store
.vs/
.vscode/
*.pem

# installers and other large binaries don't belong in the repo
*.msi
*.exe
*.dmg

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# vercel
.vercel/

# generated by Next.js (references .next/ types)
next-env.d.ts

# TypeScript incremental build cache
*.tsbuildinfo

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
# generated by apps/web/scripts/vendor.mjs
apps/web/public/vendor/
apps/web/public/drop/

# python
__pycache__/
*.pyc

# personal location history: only the generated public/side-quests/travel.json belongs in the repo
Timeline*.json

# clasp writes this while deploying Photo Drop
packages/photo-drop/backend/.clasp.json
packages/photo-drop/backend/config.gs

# engine/arcade build tools and intermediate files
packages/engine/.tools/
packages/engine/build/
packages/arcade/.tools/
packages/arcade/build/
apps/web/public/arcade/
