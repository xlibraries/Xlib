{
  "name": "@xlibraries/engine-audio",
  "version": "0.1.0",
  "description": "Sound for C++/sokol modules: a push-model mixer API (xl_audio.h) on a Web Audio AudioWorklet, with a gain the desktop's volume drives",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/xlibraries/Xlib.git",
    "directory": "packages/engine/audio"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "include",
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "eslint . && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  },
  "xlibraries": {
    "native": {
      "prefix": "engine-audio",
      "include": [
        "include"
      ],
      "link": [
        "src/xl_audio.cpp"
      ],
      "assets": [
        "src/xl-audio-worklet.js"
      ]
    }
  }
}
