{
  "name": "@xlibraries/browser",
  "version": "0.1.0",
  "description": "A tabbed browser app for the Xlib desktop, with frame-check and reader-view fallbacks",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "eslint . && tsc --noEmit && vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@xlibraries/app-sdk": "workspace:^",
    "linkedom": "0.18.12",
    "sanitize-html": "2.17.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.3.0",
    "@types/sanitize-html": "2.16.0",
    "react": "^19.2.9",
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  }
}
