{
  "name": "@xlibraries/adapter-native-test",
  "version": "0.1.0",
  "description": "Toolchain adapter: a package's graphics-free C++ under doctest, with the system compilers; doctest is its public header",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/xlibraries/Xlib.git", "directory": "packages/tooling/adapter-native-test" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "bin": {
    "xl-native-test": "./bin/xl-native-test.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": ["src", "bin", "include"],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "eslint . && vitest run"
  },
  "devDependencies": {
    "vitest": "3.2.4"
  }
