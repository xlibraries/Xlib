{
  "name": "@xlibraries/bot-lab",
  "version": "0.1.0",
  "description": "An electronics and robotics simulator for the Xlib desktop: real parts on a bench, a circuit solver, real Arduino and Raspberry Pi code",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "firmware",
    "templates",
    "scripts",
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "eslint . && tsc --noEmit && vitest run",
    "compile:templates": "node scripts/compile-templates.mjs",
    "sync:templates": "node scripts/sync-templates.mjs",
    "sync:python": "node scripts/sync-python.mjs",
    "build:native": "xl-build"
  },
  "dependencies": {
    "@xlibraries/app-sdk": "workspace:^",
    "@xlibraries/engine-react": "workspace:^",
    "avr8js": "0.21.1",
    "pyodide": "314.0.7",
    "rp2040js": "1.4.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.3.0",
    "@xlibraries/adapter-cpp-wasm": "workspace:^",
    "@xlibraries/engine-core": "workspace:^",
    "@xlibraries/engine-web": "workspace:^",
    "@xlibraries/physics-3d": "workspace:^",
    "@xlibraries/toolchain": "workspace:^",
    "react": "^19.2.9",
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  },
  "xlibraries": {
    "modules": {
      "view": {
        "adapter": "cpp-wasm",
        "uses": [
          "@xlibraries/engine-core",
          "@xlibraries/engine-web"
        ],
        "sources": [
          "view/view.cpp"
        ],
        "shaders": [
          "shaders/view.glsl"
        ],
        "flags": [
          "-sEXPORTED_FUNCTIONS=_main,_malloc,_free,_bl_view_track,_bl_view_bodies,_bl_view_poses,_bl_view_sensors,_bl_view_focus",
          "-sEXPORTED_RUNTIME_METHODS=HEAPF32"
        ]
      },
      "world": {
        "adapter": "cpp-wasm",
        "uses": [
          "@xlibraries/physics-3d"
        ],
        "sources": [
          "world/world.cpp"
        ],
        "headless": true,
        "exportName": "createWorld",
        "flags": [
          "-sEXPORTED_FUNCTIONS=_bl_reset,_bl_robot,_bl_torque,_bl_step,_bl_state,_bl_point,_bl_arm,_bl_arm_target,_bl_arm_state,_bl_conveyor,_bl_belt,_bl_cube,_bl_cube_pos,_bl_bin,_bl_sees_cube,_bl_body_count,_bl_shapes,_bl_poses,_bl_quad,_bl_quad_motors,_bl_wind,_bl_quad_state,_bl_quad_range,_malloc,_free",
          "-sEXPORTED_RUNTIME_METHODS=HEAPF32"
        ]
      }
    }
  }
}
