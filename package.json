{
  "name": "xlib",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @xlibraries/web dev",
    "build": "pnpm --filter @xlibraries/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "graph": "node packages/tooling/graph/bin/graph.mjs",
    "docs:api": "doxygen Doxyfile",
    "verify": "pnpm graph && pnpm -r --workspace-concurrency=1 verify",
    "prepare": "git config core.hooksPath .githooks || true",
    "deploy:photo-drop": "pnpm --filter @xlibraries/web exec node --env-file-if-exists=.env.local scripts/deploy-photo-drop.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "8.71.2"
  }
}
