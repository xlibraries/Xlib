{
  "name": "xlib",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @xlibraries/web dev",
    "build": "pnpm --filter @xlibraries/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm -r --workspace-concurrency=1 verify",
    "prepare": "git config core.hooksPath .githooks || true"
  }
}
