#!/bin/sh
# Runs the full check suite before every commit: `pnpm verify` at the root runs each workspace
# package's verify (the site: lint, types, unit, Python, build, e2e; packages: types and unit tests).
# Skip in an emergency with: git commit --no-verify
set -e
if command -v pnpm >/dev/null 2>&1; then PNPM="pnpm"; else PNPM="npx -y pnpm@9.15.4"; fi
echo "▶ pre-commit: running pnpm verify (about 2 minutes)…"
$PNPM verify
